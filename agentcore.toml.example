[agent]
system_prompt = "You are a helpful AI assistant. Use tools when they are useful."
database_path = "agentcore.db"
max_iterations = 8
tool_result_max_chars = 32768
memory_max_chars = 4000
memory_recall_top_k = 5
memory_recall_max_chars = 4000

[retry]
max_attempts = 3
base_delay_seconds = 0.5
max_delay_seconds = 10.0
jitter_ratio = 0.2
max_retry_after_seconds = 10.0

[workers]
turn_workers = 4
operation_workers = 8
queue_capacity = 128

[timeouts]
run_budget_seconds = 300.0
tool_seconds = 60.0
memory_seconds = 5.0
observer_seconds = 2.0
policy_seconds = 30.0
review_schedule_seconds = 1.0
finalize_seconds = 5.0

[lease]
ttl_seconds = 30.0
renew_interval_seconds = 10.0
wait_timeout_seconds = 300.0

[tools]
allow_private_web_addresses = false
allow_private_browser_addresses = false
artifact_max_bytes = 2000000
search_timeout_seconds = 30.0
browser_idle_seconds = 900.0
clarify_timeout_seconds = 3600.0
approval_timeout_seconds = 300.0

# Optional MCP: install with uv sync --extra mcp and add "mcp" to session.enabled_toolsets.
# [tools.mcp_servers.local]
# command = "python"
# args = ["E:/mcp_servers/server.py"]
# required = false
# connect_timeout_seconds = 15
# tool_timeout_seconds = 60
# requires_approval = true
# include = ["search_*", "get_*"]
# exclude = ["get_secret_*"]
# [tools.mcp_servers.local.env]
# API_TOKEN = "env:MCP_LOCAL_TOKEN"

# [tools.mcp_servers.remote]
# url = "https://example.com/mcp"
# [tools.mcp_servers.remote.headers]
# Authorization = "env:MCP_REMOTE_AUTHORIZATION"

# Local Modular RAG service (uses its existing environment and data/config).
# [tools.mcp_servers.rag]
# command = "E:/FunAgent/mcp_server/MODULAR-RAG/.venv/Scripts/python.exe"
# args = ["-m", "src.mcp_server.server"]
# required = true
# connect_timeout_seconds = 60
# tool_timeout_seconds = 60
# requires_approval = false
# include = ["query_knowledge_hub", "list_collections", "get_document_summary"]
# [tools.mcp_servers.rag.env]
# PYTHONPATH = "E:/FunAgent/mcp_server/MODULAR-RAG"
# PYTHONIOENCODING = "utf-8"

# Permanent approval scopes are written here only after explicit human approval.
# [approvals]
# always = ["cua:type:background"]


[logging]
enabled = true
directory = "logs"
level = "INFO"
queue_capacity = 2048
agent_max_size_mb = 5
agent_backup_count = 3
errors_max_size_mb = 2
errors_backup_count = 2
gateway_max_size_mb = 5
gateway_backup_count = 3

[[routes]]
name = "primary"
provider = "openai"
model = "gpt-4.1-mini"
api_mode = "chat_completions"
base_url = "https://api.openai.com/v1"
credential_ref = "env:OPENAI_API_KEY"
timeout_seconds = 60.0

# Add more [[routes]] blocks below the primary route to configure fallbacks.
[session]
enabled_toolsets = ["default", "memory"]
disabled_toolsets = []
enabled_tools = []  # Exact registered tool names, including names outside enabled toolsets.
disabled_tools = []  # Denies take precedence; permissions and availability still apply.
permissions = []

# Paths are relative to this config file; no process-wide chdir is used.
[workspace]
default_cwd = "."
allowed_root = "."

# Durable memory is enabled by default. Paths are relative to this file.
[memory]
enabled = true
backend = "sqlite"
review_every_turns = 10  # 0 disables background review

[memory.sqlite]
path = "memories/memory.db"

# Optional Supabase memory: set memory.backend = "supabase" and install the extra.
# Deploy sql/supabase/001_memory.sql first; vector dimensions must match the model.
# SQLite above continues to hold only local review progress when Supabase is selected.
# [memory.supabase]
# url = "https://YOUR_PROJECT.supabase.co"
# credential_ref = "env:SUPABASE_SECRET_KEY"
# namespace = "personal-agent"
# timeout_seconds = 20
# min_similarity = 0.3  # calibrate with the actual embedding model
#
# [memory.supabase.embedding]
# base_url = "http://127.0.0.1:1234/v1"  # LM Studio; Ollama: http://127.0.0.1:11434/v1
# model = "YOUR_LOCAL_EMBEDDING_MODEL"
# dimensions = 1024
# credential_ref = "env:EMBEDDING_API_KEY"  # omit for a service without authentication
# query_prefix = ""      # optional, only if required by the model
# document_prefix = ""

# Prepare knowledge before the main model. Enable the rag MCP server above first.
# Omitting [knowledge.planner] reuses routes[0] with a separate planning prompt.
[knowledge]
enabled = false
source_description = "项目内部文档、产品使用说明与业务制度"
max_queries = 3
top_k = 5
max_items = 6
history_max_chars = 8000
context_max_chars = 12000
timeout_seconds = 20
planner_timeout_seconds = 5

[knowledge.mcp]
server = "rag"
tool = "query_knowledge_hub"
collection = "knowledge_hub"
hidden_tools = ["query_knowledge_hub", "list_collections", "get_document_summary"]

# Optional separate route; model may also be the same model as the main route.
# [knowledge.planner]
# name = "knowledge-planner"
# provider = "openai_compatible"
# model = "YOUR_PLANNING_MODEL"
# api_mode = "chat_completions"
# base_url = "https://YOUR_MODEL_ENDPOINT/v1"
# credential_ref = "env:KNOWLEDGE_MODEL_API_KEY"
