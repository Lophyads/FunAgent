[agent]
system_prompt = "You are a helpful AI assistant. Use tools when they are useful."
database_path = "agentcore.db"
max_iterations = 8
tool_result_max_chars = 32768
memory_max_chars = 4000

[retry]
max_attempts = 3
base_delay_seconds = 0.5
max_delay_seconds = 10.0
jitter_ratio = 0.2
max_retry_after_seconds = 10.0

[workers]
turn_workers = 4
operation_workers = 8
queue_capacity = 128

[timeouts]
run_budget_seconds = 300.0
tool_seconds = 60.0
memory_seconds = 5.0
observer_seconds = 2.0
policy_seconds = 30.0
review_schedule_seconds = 1.0
finalize_seconds = 5.0

[lease]
ttl_seconds = 30.0
renew_interval_seconds = 10.0
wait_timeout_seconds = 300.0

[tools]
allow_private_web_addresses = false
allow_private_browser_addresses = false
artifact_max_bytes = 2000000
search_timeout_seconds = 30.0
browser_idle_seconds = 900.0
clarify_timeout_seconds = 3600.0
approval_timeout_seconds = 300.0

# Optional MCP: install with uv sync --extra mcp and add "mcp" to session.enabled_toolsets.
# [tools.mcp_servers.local]
# command = "python"
# args = ["E:/mcp_servers/server.py"]
# required = false
# connect_timeout_seconds = 15
# tool_timeout_seconds = 60
# requires_approval = true
# include = ["search_*", "get_*"]
# exclude = ["get_secret_*"]
# [tools.mcp_servers.local.env]
# API_TOKEN = "env:MCP_LOCAL_TOKEN"

# [tools.mcp_servers.remote]
# url = "https://example.com/mcp"
# [tools.mcp_servers.remote.headers]
# Authorization = "env:MCP_REMOTE_AUTHORIZATION"

# Local Modular RAG service (uses its existing environment and data/config).
# [tools.mcp_servers.rag]
# command = "E:/MODULAR-RAG-MCP-SERVER-main/.venv/Scripts/python.exe"
# args = ["-m", "src.mcp_server.server"]
# required = true
# connect_timeout_seconds = 60
# tool_timeout_seconds = 60
# requires_approval = false
# include = ["query_knowledge_hub", "list_collections", "get_document_summary"]
# [tools.mcp_servers.rag.env]
# PYTHONPATH = "E:/MODULAR-RAG-MCP-SERVER-main"
# PYTHONIOENCODING = "utf-8"

# Permanent approval scopes are written here only after explicit human approval.
# [approvals]
# always = ["cua:type:background"]


[logging]
enabled = true
directory = "logs"
level = "INFO"
queue_capacity = 2048
agent_max_size_mb = 5
agent_backup_count = 3
errors_max_size_mb = 2
errors_backup_count = 2
gateway_max_size_mb = 5
gateway_backup_count = 3

[[routes]]
name = "primary"
provider = "openai"
model = "gpt-4.1-mini"
api_mode = "chat_completions"
base_url = "https://api.openai.com/v1"
credential_ref = "env:OPENAI_API_KEY"
timeout_seconds = 60.0

# Add more [[routes]] blocks below the primary route to configure fallbacks.
[session]
enabled_toolsets = ["default", "memory"]
disabled_toolsets = []
permissions = []

# Paths are relative to this config file; no process-wide chdir is used.
[workspace]
default_cwd = "."
allowed_root = "."

# Optional durable memory. Relative directory is resolved beside this file.
[file_memory]
enabled = true
directory = "memories"
memory_char_limit = 2200
user_char_limit = 1375
review_every_turns = 10  # 0 disables background review
